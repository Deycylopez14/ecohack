{
  "name": "ecohack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --host --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "preview:https": "vite preview --https",
    "build:pwa": "vite build && echo PWA build completed",
    "serve": "npx serve dist --single --listen 3000",
    "serve:https": "npx serve dist --single --listen 3000 --ssl",
    "pwa:test": "npm run build:pwa && npm run serve",
    "pwa:test:https": "npm run build:pwa && npm run serve:https",
    "setup:https": "setup-https.bat",
    "tunnel": "start-https-tunnel.bat"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.76.1",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.12.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.1.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.20.0"
  }
}
